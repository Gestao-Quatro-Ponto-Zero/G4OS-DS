{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "baseUrl": ".",
    "paths": {
      "@g4ai/ds": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "showcase/**/*.tsx",
    "showcase/**/*.ts"
  ],
  "exclude": [
    "showcase/dist",
    "templates"
  ]
}
